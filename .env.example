# Copy to .env and fill in real values. Never commit .env.

# Auth / crypto — generate real values before deploying anywhere shared:
#   JWT_SECRET:      openssl rand -hex 32
#   ENCRYPTION_KEY:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Postgres (docker-compose sets DATABASE_URL itself to point at the `db` service;
# only needed here if running the backend outside docker-compose)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chatbot_builder

# Legacy single-tenant values — only read by backend/scripts/migrate_legacy.py
IBM_API_KEY=
PROJECT_ID=
IBM_REGION=
